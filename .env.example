# 로컬 개발용 — apps/functions/.env.local 로 복사해서 사용 (.env 가 아님: firebase deploy 가 .env 를 업로드함)
# 배포 환경의 값은 Firebase 시크릿으로 설정 (README 참고)

# 관리자로 허용할 Google 계정 이메일 (쉼표/공백 구분). 필수 — 비어 있으면 아무도 로그인할 수 없음
ADMIN_EMAILS=you@example.com

# AI 제공자: anthropic | openai (미지정 시 ANTHROPIC_API_KEY가 있으면 anthropic)
AI_PROVIDER=anthropic

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=medium

# OpenAI (선택)
OPENAI_API_KEY=sk-...

# 허용 오리진 (Firebase Hosting 도메인 또는 * )
ALLOWED_ORIGIN=*
