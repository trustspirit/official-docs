# 관리자 계정 — ADMIN_PASSWORD, SECRET_KEY 는 필수 (기본값 없음, 미설정 시 로그인 불가)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<직접 정한 강한 비밀번호>

# JWT 서명 키 (32자 이상). 생성: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=<위 명령으로 생성한 값>
ACCESS_TOKEN_EXPIRE_MINUTES=480

# AI 제공자: anthropic | openai (미지정 시 ANTHROPIC_API_KEY가 있으면 anthropic)
AI_PROVIDER=anthropic

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=medium

# OpenAI (선택)
OPENAI_API_KEY=sk-...

# 허용 오리진 (Firebase Hosting 도메인 또는 * )
ALLOWED_ORIGIN=*
