{
  "hosting": {
    "public": "apps/web/dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "function": "api",
        "region": "asia-northeast3"
      },
      {
        "source": "/s/**",
        "function": "api",
        "region": "asia-northeast3"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "target": "app"
  },
  "functions": {
    "source": "apps/functions",
    "runtime": "python311",
    "codebase": "default",
    "ignore": [
      "venv",
      ".venv",
      "__pycache__",
      "*.pyc",
      ".env.local",
      ".env.*.local",
      "tests"
    ]
  },
  "storage": {
    "rules": "storage.rules"
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": false
    }
  }
}
